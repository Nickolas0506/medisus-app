{
  "expo": {
    "name": "MediSUS",
    "slug": "medisus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.medisus"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0E7C66"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fiap.medisus",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F8F7"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O MediSUS usa a câmera para fotografar a sua receita.",
          "photosPermission": "O MediSUS acessa suas fotos para ler uma receita já fotografada."
        }
      ]
    ],
    "extra": {
      "apiUrlProducao": "https://medisus.onrender.com/api",
      "repositorio": ""
    }
  }
}
